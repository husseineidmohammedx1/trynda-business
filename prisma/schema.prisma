generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                     @id @default(cuid())
  name                String
  email               String                     @unique
  passwordHash        String
  role                Role                       @default(BOOSTER)
  active              Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  platformFeePercent  Decimal                    @default(7) @db.Decimal(5, 2)
  extraPenaltyPercent Decimal                    @default(0) @db.Decimal(5, 2)
  balanceUsd          Decimal                    @default(0) @db.Decimal(12, 2)
  totalEarnedUsd      Decimal                    @default(0) @db.Decimal(12, 2)
  totalPaidUsd        Decimal                    @default(0) @db.Decimal(12, 2)
  profileImageUrl     String?
  telegramChatId      String?
  paymentMethod       PaymentMethod?
  paymentNumber       String?
  deductions          Deduction[]
  notifications       Notification[]
  orders              Order[]                    @relation("BoosterOrders")
  passwordResetTokens PasswordResetToken[]
  payments            Payment[]                  @relation("BoosterPayments")
  paymentTransactions BoosterPaymentTransaction[]
}

model Order {
  id                  String      @id
  title               String
  game                String      @default("World of Warcraft")
  customer            String?
  description         String?
  characterName      String?
  battleTag           String?
  faction             String?
  serverName          String?
  vpnLocation         String?
  region              String?
  priceUsd            Decimal     @db.Decimal(12, 2)
  platformFeePercent  Decimal     @default(7) @db.Decimal(5, 2)
  extraPenaltyPercent Decimal     @default(0) @db.Decimal(5, 2)
  platformFeeUsd      Decimal     @default(0) @db.Decimal(12, 2)
  extraPenaltyUsd     Decimal     @default(0) @db.Decimal(12, 2)
  boosterAmountUsd    Decimal     @default(0) @db.Decimal(12, 2)
  deductionUsd        Decimal     @default(0) @db.Decimal(12, 2)
  exchangeRate        Decimal     @db.Decimal(12, 4)
  status              OrderStatus @default(PENDING)
  boosterId           String?
  createdAt           DateTime    @default(now())
  completedAt         DateTime?
  booster             User?       @relation("BoosterOrders", fields: [boosterId], references: [id])
  payment             Payment?
}

model Payment {
  id               String                         @id @default(cuid())
  orderId          String                         @unique
  boosterId        String?
  orderPriceUsd    Decimal                        @db.Decimal(12, 2)
  platformFeeUsd   Decimal                        @db.Decimal(12, 2)
  extraPenaltyUsd  Decimal                        @db.Decimal(12, 2)
  boosterAmountUsd Decimal                        @db.Decimal(12, 2)
  finedUsd         Decimal                        @default(0) @db.Decimal(12, 2)
  netAmountUsd     Decimal                        @db.Decimal(12, 2)
  exchangeRate     Decimal                        @db.Decimal(12, 4)
  amountEgp        Decimal                        @db.Decimal(12, 2)
  status           PaymentStatus                  @default(PENDING)
  completedAt      DateTime?
  releaseAt        DateTime?
  paidAt           DateTime?
  createdAt        DateTime                       @default(now())
  paidAmountEgp    Decimal?                       @db.Decimal(12, 2)
  paidAmountUsd    Decimal?                       @db.Decimal(12, 2)
  paidExchangeRate Decimal?                       @db.Decimal(12, 4)
  booster          User?                          @relation("BoosterPayments", fields: [boosterId], references: [id])
  order            Order                          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocations      PaymentTransactionAllocation[]
}

model Deduction {
  id           String   @id @default(cuid())
  reason       String
  amountUsd    Decimal  @db.Decimal(12, 2)
  userId       String?
  createdAt    DateTime @default(now())
  remainingUsd Decimal  @db.Decimal(12, 2)
  user         User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BusinessSettings {
  id                 String   @id @default(cuid())
  businessName       String   @default("Trynda Business")
  platformFeePercent Decimal  @default(7) @db.Decimal(5, 2)
  holdDays           Int      @default(5)
  baseCurrency       String   @default("USD")
  localCurrency      String   @default("EGP")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BoosterPaymentTransaction {
  id String @id @default(cuid())

  boosterId String
  booster   User @relation(fields: [boosterId], references: [id], onDelete: Cascade)

  month String

  amountUsd    Decimal @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 4)
  amountEgp    Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  paymentNumber String

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  allocations PaymentTransactionAllocation[]

  @@index([boosterId, paidAt])
  @@index([boosterId, month])
}

model PaymentTransactionAllocation {
  id String @id @default(cuid())

  transactionId String
  transaction   BoosterPaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amountUsd Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([paymentId])
}

enum Role {
  ADMIN
  MANAGER
  BOOSTER
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AVAILABLE
  PAID
  CANCELLED
}

enum PaymentMethod {
  VODAFONE_CASH
  INSTAPAY
}