generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  BOOSTER
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AVAILABLE
  PAID
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(BOOSTER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  profileImageUrl String? @db.Text
  telegramChatId String?

  // Default platform fee for this booster
  platformFeePercent Decimal @default(7) @db.Decimal(5, 2)

  // Additional manual penalty for this booster
  // 0 = no additional penalty
  extraPenaltyPercent Decimal @default(0) @db.Decimal(5, 2)

  balanceUsd     Decimal @default(0) @db.Decimal(12, 2)
  totalEarnedUsd Decimal @default(0) @db.Decimal(12, 2)
  totalPaidUsd   Decimal @default(0) @db.Decimal(12, 2)

  orders     Order[]     @relation("BoosterOrders")
  payments   Payment[]   @relation("BoosterPayments")
  deductions Deduction[]
  notifications Notification[]

  passwordResetTokens PasswordResetToken[]
}

model Order {
  id       String  @id
  title    String
  game     String  @default("World of Warcraft")
  customer String?

  // Order details
  description   String?
  characterName String?
  battleTag    String?
  faction      String?
  serverName   String?
  vpnLocation  String?
  region       String?

  // Original order price
  priceUsd Decimal @db.Decimal(12, 2)

  // Fee settings saved specifically for this order
  platformFeePercent  Decimal @default(7) @db.Decimal(5, 2)
  extraPenaltyPercent Decimal @default(0) @db.Decimal(5, 2)

  // Calculated amounts
  platformFeeUsd  Decimal @default(0) @db.Decimal(12, 2)
  extraPenaltyUsd Decimal @default(0) @db.Decimal(12, 2)

  // Booster amount after percentage deductions
  boosterAmountUsd Decimal @default(0) @db.Decimal(12, 2)

  // Additional fixed/manual fine
  deductionUsd Decimal @default(0) @db.Decimal(12, 2)

  // USD -> EGP rate
  exchangeRate Decimal @db.Decimal(12, 4)

  status OrderStatus @default(PENDING)

  boosterId String?

  booster User? @relation("BoosterOrders", fields: [boosterId], references: [id], onDelete: SetNull)

  payment Payment?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Payment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  boosterId String?
  booster   User?   @relation("BoosterPayments", fields: [boosterId], references: [id])

  orderPriceUsd Decimal @db.Decimal(12, 2)

  platformFeeUsd  Decimal @db.Decimal(12, 2)
  extraPenaltyUsd Decimal @db.Decimal(12, 2)

  boosterAmountUsd Decimal @db.Decimal(12, 2)

  finedUsd Decimal @default(0) @db.Decimal(12, 2)

  netAmountUsd Decimal @db.Decimal(12, 2)

  exchangeRate Decimal @db.Decimal(12, 4)
  amountEgp    Decimal @db.Decimal(12, 2)

  paidAmountUsd    Decimal? @db.Decimal(12, 2)
  paidExchangeRate Decimal? @db.Decimal(12, 4)
  paidAmountEgp    Decimal? @db.Decimal(12, 2)

  status PaymentStatus @default(PENDING)

  completedAt DateTime?
  releaseAt   DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
}

model Deduction {
  id String @id @default(cuid())

  reason String

  amountUsd    Decimal @db.Decimal(12, 2)
  remainingUsd Decimal @db.Decimal(12, 2)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model BusinessSettings {
  id String @id @default(cuid())

  businessName String @default("Trynda Business")

  // Default website/platform fee
  platformFeePercent Decimal @default(7) @db.Decimal(5, 2)

  // Global payment hold period
  holdDays Int @default(5)

  baseCurrency  String @default("USD")
  localCurrency String @default("EGP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
